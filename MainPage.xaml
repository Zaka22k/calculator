<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Calculator.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Calculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="MainPage_KeyDown"
    Loaded="MainPage_Loaded">

    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Калькулятор программиста"
            Style="{ThemeResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Viewbox
                Grid.Row="0"
                Stretch="Uniform"
                HorizontalAlignment="Right">
                <TextBox
                    x:Name="InputDisplay"
                    Width="900"
                    Height="86"
                    Text="{Binding InputText, Mode=OneWay}"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    TextWrapping="NoWrap"
                    TextAlignment="Right"
                    VerticalContentAlignment="Center"
                    FontSize="45"
                    FontStretch="UltraCondensed"
                    Padding="10"
                    BorderThickness="0"
                    Background="Transparent"
                    SelectionFlyout="{x:Null}"
                    AutomationProperties.Name="Текущее число" />
            </Viewbox>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">

                <InfoBar
                    IsOpen="{Binding HasError}"
                    Message="{Binding ErrorMessage}"
                    Severity="Error"
                    IsClosable="False" />

                <ListView
                    x:Name="BaseList"
                    SelectionChanged="BaseList_SelectionChanged"
                    MinWidth="300"
                    MaxWidth="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{ThemeResource ControlOnImageFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    AutomationProperties.Name="Результаты в системах счисления">

                    <ListViewItem Tag="16">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HEX" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding HexValue}"
                                HorizontalAlignment="Stretch"
                                TextAlignment="Right"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem Tag="10">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DEC" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding DecimalValue}"
                                HorizontalAlignment="Stretch"
                                TextAlignment="Right"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem Tag="8">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OCT" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding OctalValue}"
                                HorizontalAlignment="Stretch"
                                TextAlignment="Right"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                        </Grid>
                    </ListViewItem>

                    <ListViewItem Tag="2">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BIN" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding BinaryValue}"
                                HorizontalAlignment="Stretch"
                                TextAlignment="Right"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                        </Grid>
                    </ListViewItem>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
