<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Calculator.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Calculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyDown="MainPage_KeyDown"
    Loaded="MainPage_Loaded"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="42*" />
            <RowDefinition Height="58*" />
        </Grid.RowDefinitions>

        <Viewbox
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Stretch="Uniform">
            <TextBox
                x:Name="InputDisplay"
                Width="850"
                Height="84"
                Padding="10"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="Текущее число"
                Background="Transparent"
                BorderThickness="0"
                FontSize="46"
                FontStretch="UltraCondensed"
                Foreground="#F5F3F2"
                IsReadOnly="True"
                IsSpellCheckEnabled="False"
                SelectionFlyout="{x:Null}"
                Text="{Binding InputText, Mode=OneWay}"
                TextAlignment="Right"
                TextWrapping="NoWrap"
                FocusVisualPrimaryBrush="Transparent"
                FocusVisualSecondaryBrush="Transparent">
                <TextBox.Resources>
                    <ResourceDictionary>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    </ResourceDictionary>
                </TextBox.Resources>
            </TextBox>
        </Viewbox>

        <ListView
            x:Name="BaseList"
            Grid.Row="1"
            Width="320"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            AutomationProperties.Name="Результаты в системах счисления"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            SelectionMode="None">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ListView.ItemContainerStyle>

            <InfoBar
                Grid.Row="1"
                Width="320"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsClosable="False"
                IsOpen="{Binding HasError}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />

            <ListViewItem Tag="16" Tapped="BaseListItem_Tapped">
                <Grid MinHeight="34" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="HexMarker"
                        Grid.Column="0"
                        Width="3"
                        Height="22"
                        VerticalAlignment="Center"
                        Background="#D3A04B"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#F5F3F2"
                        Text="HEX" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#F5F3F2"
                        Text="{Binding HexValue}"
                        TextWrapping="Wrap" />
                </Grid>
            </ListViewItem>

            <ListViewItem Tag="10" Tapped="BaseListItem_Tapped">
                <Grid MinHeight="34" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="DecMarker"
                        Grid.Column="0"
                        Width="3"
                        Height="22"
                        VerticalAlignment="Center"
                        Background="#D3A04B"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#F5F3F2"
                        Text="DEC" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#F5F3F2"
                        Text="{Binding DecimalValue}"
                        TextWrapping="Wrap" />
                </Grid>
            </ListViewItem>

            <ListViewItem Tag="8" Tapped="BaseListItem_Tapped">
                <Grid MinHeight="34" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="OctMarker"
                        Grid.Column="0"
                        Width="3"
                        Height="22"
                        VerticalAlignment="Center"
                        Background="#D3A04B"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#F5F3F2"
                        Text="OCT" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#F5F3F2"
                        Text="{Binding OctalValue}"
                        TextWrapping="Wrap" />
                </Grid>
            </ListViewItem>

            <ListViewItem Tag="2" Tapped="BaseListItem_Tapped">
                <Grid MinHeight="34" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="BinMarker"
                        Grid.Column="0"
                        Width="3"
                        Height="22"
                        VerticalAlignment="Center"
                        Background="#D3A04B"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#F5F3F2"
                        Text="BIN" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#F5F3F2"
                        Text="{Binding BinaryValue}"
                        TextWrapping="Wrap" />
                </Grid>
            </ListViewItem>
        </ListView>
    </Grid>
</Page>
